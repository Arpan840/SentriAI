{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",

    "strict": true,

    "declaration": true,
    "declarationMap": true,

    "rootDir": "./src",
    "outDir": "./dist",

    "esModuleInterop": true,

    "skipLibCheck": true,

    "ignoreDeprecations": "6.0"
  },

  "include": ["src/**/*"]
}